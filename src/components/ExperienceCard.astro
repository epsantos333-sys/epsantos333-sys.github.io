---
import type { Role } from '../data/experience';
interface Props { role: Role }
const { role: r } = Astro.props;
const href = r.slug ? `/experience/${r.slug}/` : undefined;
const Tag = href ? 'a' : 'article';
---
<Tag class:list={['card', 'exp-card', { link: href }]} href={href}>
  <div class="meta">
    <span class="label">{r.kind} · {r.area}</span>
    <span class="mono muted dates">{r.dates}</span>
  </div>
  <h3>{r.company}</h3>
  <p class="role">{r.role} · {r.place}</p>
  {r.metrics.length > 0 && (
    <dl class="metrics">
      {r.metrics.map((m) => (
        <div><dt>{m.value}</dt><dd>{m.label}</dd></div>
      ))}
    </dl>
  )}
  {r.metrics.length === 0 && <p class="muted">{r.summary}</p>}
  {href && <span class="mono more">Read more →</span>}
</Tag>

<style>
  .exp-card { display: block; text-decoration: none; color: inherit; }
  .exp-card.link:hover { border-color: var(--text); color: inherit; }
  .meta { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 4px 12px; }
  .dates { font-size: 0.85rem; }
  h3 { margin: 8px 0 2px; color: var(--text); }
  .role { color: var(--muted); margin-bottom: 14px; }
  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; margin: 0 0 14px; }
  .metrics > div { min-width: 0; border-left: 2px solid var(--border); padding-left: 10px; }
  .metrics dt { font-weight: 600; font-size: 1.15rem; font-variant-numeric: tabular-nums; }
  .metrics dd { margin: 0; color: var(--muted); font-size: 0.85rem; line-height: 1.35; }
  .more { font-size: 0.85rem; color: var(--text); }
</style>
