---
// Decorative trace of Eli's SECOM s059 I-MR chart (data from scripts/make_spc_data.py).
// part="i": I chart with control limits, train/test split and fail marks.
// part="mr": moving-range trace with its upper limit, used as a thin strip.
import spc from '../data/spc_s059.json';

interface Props {
  part: 'i' | 'mr';
  class?: string;
}
const { part, class: className } = Astro.props;

const W = spc.x.length;
const H = part === 'i' ? 300 : 60;
// Fixed y windows so the regime change reads clearly; the two big spikes run off the top.
const [yMin, yMax] = part === 'i' ? [-30, 45] : [0, 40];
const y = (v: number) => (H - ((v - yMin) / (yMax - yMin)) * H).toFixed(1);

const series = part === 'i' ? spc.x : spc.x.slice(1).map((v, i) => Math.abs(v - spc.x[i]));
const x0 = part === 'i' ? 0 : 1;
const trace = series.map((v, i) => `${i ? 'L' : 'M'}${i + x0},${y(v)}`).join('');
const limits = part === 'i' ? [spc.ucl, spc.center, spc.lcl] : [spc.mr_ucl];
const fails = part === 'i' ? spc.fail_idx.map((i) => ({ cx: i, cy: Number(y(spc.x[i])) })) : [];
---
<svg
  class:list={['spc', `spc-${part}`, className]}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  {limits.map((v) => (
    <line x1="0" x2={W} y1={y(v)} y2={y(v)} class="spc-limit" vector-effect="non-scaling-stroke" />
  ))}
  <line x1={spc.n_train} x2={spc.n_train} y1="0" y2={H} class="spc-split" vector-effect="non-scaling-stroke" />
  <path d={trace} class="spc-trace" vector-effect="non-scaling-stroke" />
  {fails.map((f) => (
    <path d={`M${f.cx - 4},${f.cy - 4}L${f.cx + 4},${f.cy + 4}M${f.cx - 4},${f.cy + 4}L${f.cx + 4},${f.cy - 4}`} class="spc-fail" vector-effect="non-scaling-stroke" />
  ))}
</svg>

<style>
  .spc { display: block; width: 100%; height: 100%; overflow: hidden; }
  .spc-trace { fill: none; stroke: var(--chart); stroke-width: 1; }
  .spc-limit { stroke: var(--chart); stroke-width: 1; stroke-dasharray: 5 5; }
  .spc-split { stroke: var(--chart); stroke-width: 1.2; }
  .spc-fail { fill: none; stroke: var(--chart); stroke-width: 1.2; }
</style>
