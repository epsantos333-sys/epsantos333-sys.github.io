---
// Saturation-temperature solver loop for the Peng-Robinson project.
---
<svg viewBox="0 0 760 250" role="img" aria-label="Solver loop: pick pressure, guess temperature, solve the Peng-Robinson cubic for liquid and vapor Z, compute fugacity coefficients, check ln of phi L over phi V, and let Brent's method update temperature until it reaches zero">
  <defs>
    <marker id="ah-eos" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" class="dg-head" />
    </marker>
  </defs>

  <rect x="10" y="40" width="110" height="60" rx="4" class="dg-box" />
  <text x="65" y="66" text-anchor="middle" class="dg-text">pick P</text>
  <text x="65" y="86" text-anchor="middle" class="dg-sub">0.6 kPa–22 MPa</text>

  <rect x="155" y="40" width="130" height="60" rx="4" class="dg-box warm" />
  <text x="220" y="66" text-anchor="middle" class="dg-text">Brent's method</text>
  <text x="220" y="86" text-anchor="middle" class="dg-sub">update T</text>

  <rect x="320" y="40" width="140" height="60" rx="4" class="dg-box hl" />
  <text x="390" y="66" text-anchor="middle" class="dg-text">PR cubic in Z</text>
  <text x="390" y="86" text-anchor="middle" class="dg-sub">roots Z_L, Z_V</text>

  <rect x="495" y="40" width="120" height="60" rx="4" class="dg-box hl" />
  <text x="555" y="66" text-anchor="middle" class="dg-text">ln φ_L, ln φ_V</text>

  <rect x="495" y="150" width="255" height="60" rx="4" class="dg-box" />
  <text x="622" y="176" text-anchor="middle" class="dg-text">F(T) = ln(φ_L / φ_V)</text>
  <text x="622" y="196" text-anchor="middle" class="dg-sub">equal fugacity ⇔ F = 0</text>

  <rect x="155" y="150" width="130" height="60" rx="4" class="dg-box" />
  <text x="220" y="176" text-anchor="middle" class="dg-text">T_sat(P)</text>
  <text x="220" y="196" text-anchor="middle" class="dg-sub">vs steam tables</text>

  <path d="M120 70 H153" class="dg-arrow" marker-end="url(#ah-eos)" />
  <path d="M285 70 H318" class="dg-arrow" marker-end="url(#ah-eos)" />
  <path d="M460 70 H493" class="dg-arrow" marker-end="url(#ah-eos)" />
  <path d="M615 70 H680 V148" class="dg-arrow" marker-end="url(#ah-eos)" />
  <path d="M560 150 V125 H240 V102" class="dg-dash" marker-end="url(#ah-eos)" />
  <text x="400" y="142" text-anchor="middle" class="dg-sub">|F| > tol: iterate</text>
  <path d="M495 180 H287" class="dg-arrow" marker-end="url(#ah-eos)" />
  <text x="390" y="172" text-anchor="middle" class="dg-sub">converged</text>
</svg>
