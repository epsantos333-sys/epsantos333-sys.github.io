---
// Pipeline for the SECOM project. Train-only steps sit inside the dashed region.
---
<svg viewBox="0 0 760 300" role="img" aria-label="SECOM pipeline: raw data, time split, train-only cleaning, then I-MR charts, PCA T² and SPE monitoring, and fail prediction, all evaluated on later test runs">
  <defs>
    <marker id="ah-secom" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" class="dg-head" />
    </marker>
  </defs>

  <rect x="10" y="110" width="130" height="64" rx="4" class="dg-box" />
  <text x="75" y="136" text-anchor="middle" class="dg-text">raw data</text>
  <text x="75" y="156" text-anchor="middle" class="dg-sub">1567 runs × 590</text>

  <rect x="175" y="110" width="110" height="64" rx="4" class="dg-box warm" />
  <text x="230" y="136" text-anchor="middle" class="dg-text">time split</text>
  <text x="230" y="156" text-anchor="middle" class="dg-sub">earlier | later</text>

  <rect x="310" y="20" width="440" height="200" rx="6" class="dg-dash" />
  <text x="322" y="40" class="dg-sub">fit on training runs only</text>

  <rect x="325" y="110" width="120" height="64" rx="4" class="dg-box" />
  <text x="385" y="136" text-anchor="middle" class="dg-text">clean + scale</text>
  <text x="385" y="156" text-anchor="middle" class="dg-sub">drop, impute</text>

  <rect x="490" y="52" width="245" height="44" rx="4" class="dg-box hl" />
  <text x="612" y="79" text-anchor="middle" class="dg-text">I-MR charts (univariate)</text>
  <rect x="490" y="120" width="245" height="44" rx="4" class="dg-box hl" />
  <text x="612" y="147" text-anchor="middle" class="dg-text">PCA → T² and SPE charts</text>
  <rect x="490" y="174" width="245" height="40" rx="4" class="dg-box hl" />
  <text x="612" y="199" text-anchor="middle" class="dg-text">fail classifier</text>

  <rect x="325" y="240" width="410" height="48" rx="4" class="dg-box" />
  <text x="530" y="262" text-anchor="middle" class="dg-text">evaluate on later test runs</text>
  <text x="530" y="279" text-anchor="middle" class="dg-sub">alarm rate on good runs · ROC-AUC vs shuffled split</text>

  <path d="M140 142 H173" class="dg-arrow" marker-end="url(#ah-secom)" />
  <path d="M285 142 H323" class="dg-arrow" marker-end="url(#ah-secom)" />
  <path d="M445 142 H468 V74 H488" class="dg-arrow" marker-end="url(#ah-secom)" />
  <path d="M468 142 H488" class="dg-arrow" marker-end="url(#ah-secom)" />
  <path d="M468 142 V194 H488" class="dg-arrow" marker-end="url(#ah-secom)" />
  <path d="M230 174 V264 H323" class="dg-arrow" marker-end="url(#ah-secom)" />
  <text x="238" y="256" class="dg-sub">test runs</text>
</svg>
