---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SpcChart from '../components/SpcChart.astro';
import { projects } from '../data/projects';

const interests = [
  {
    name: 'Physics-informed machine learning',
    detail: 'Models that learn from large datasets but keep mass and energy balances, so predictions stay physical outside the training data.',
  },
  {
    name: 'Hybrid process models',
    detail: 'Mechanistic kinetics and thermodynamics with a learned correction for the behavior first principles miss.',
  },
  {
    name: 'Process monitoring',
    detail: 'Statistical process control and multivariate monitoring on real plant and fab sensor data.',
  },
  {
    name: 'Manufacturing yield',
    detail: 'Using production data to find root causes and cut defects, as in semiconductor fabs and battery lines.',
  },
];
---
<Base title="Home">
  <section class="hero">
    <div class="hero-chart" aria-hidden="true"><SpcChart part="i" /></div>
    <p class="label">Chemical engineering · UNR · B.S. May 2027</p>
    <h1>Eli Santos</h1>
    <p class="lede">
      I build models of chemical and manufacturing processes, and I test them honestly. My focus is
      physics-informed and hybrid machine learning, process monitoring and data-driven yield improvement.
    </p>
    <p class="muted">
      Internships at Micron Technology (facilities chemical engineering) and Panasonic Energy (cell and process
      engineering). Applying to master’s programs for Fall 2027.
    </p>
    <div class="cta">
      <a class="btn" href="/projects/">See projects</a>
      <a class="btn ghost" href="/about/">Experience and resume</a>
    </div>
  </section>

  <h2>Interests</h2>
  <div class="interests">
    {interests.map((i) => (
      <div class="card">
        <h3>{i.name}</h3>
        <p class="muted">{i.detail}</p>
      </div>
    ))}
  </div>

  <h2>Projects</h2>
  <div class="grid">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>

  <h2 id="contact">Contact</h2>
  <p>
    Email <a href="mailto:eli.santos.paul@gmail.com">eli.santos.paul@gmail.com</a>, or find me on <a href="https://www.linkedin.com/in/elisantosengineering">LinkedIn</a> and <a href="https://github.com/epsantos333-sys">GitHub</a>.
  </p>
</Base>

<style>
  .hero { position: relative; isolation: isolate; padding: 24px 0 150px; }
  /* Spans the full window width behind the intro; the noisy early runs sit on the left, under the buttons. */
  .hero-chart {
    position: absolute;
    z-index: -1;
    left: calc(50% - 50vw);
    width: 100vw;
    bottom: 0;
    height: 200px;
    opacity: 0.14;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 30%);
    mask-image: linear-gradient(to bottom, transparent, #000 30%);
  }
  @media (max-width: 640px) { .hero { padding-bottom: 110px; } .hero-chart { height: 150px; opacity: 0.11; } }
  .lede { font-size: 1.2rem; max-width: 40em; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  .btn {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    padding: 9px 16px;
    border-radius: 4px;
    background: var(--accent);
    color: var(--bg);
    text-decoration: none;
  }
  .btn:hover { background: var(--accent-2); color: var(--bg); }
  .btn.ghost { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
  .btn.ghost:hover { color: var(--accent-2); border-color: var(--accent-2); background: transparent; }
  .grid { display: grid; gap: 16px; }
  .interests { display: grid; gap: 16px; grid-template-columns: repeat(2, 1fr); }
  @media (max-width: 640px) { .interests { grid-template-columns: 1fr; } }
  .interests > * { min-width: 0; }
  .interests h3 { margin-bottom: 0.3em; }
  .interests p { margin: 0; font-size: 0.95rem; }
</style>
