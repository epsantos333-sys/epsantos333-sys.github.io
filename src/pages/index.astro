---
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import SpcChart from '../components/SpcChart.astro';
import { internships } from '../data/experience';
import { projects } from '../data/projects';
import { existsSync } from 'node:fs';

// Show the photo once public/headshot.jpg exists (square crop, at least 400 x 400 px).
const hasPhoto = existsSync('public/headshot.jpg');
---
<Base title="Home">
  <section class="hero">
    <div class="hero-chart" aria-hidden="true"><SpcChart part="i" /></div>
    <div class="intro-head">
      {hasPhoto && <img class="photo" src="/headshot.jpg" alt="Eli Santos" width="132" height="132" />}
      <div>
        <h1>Eli Santos</h1>
        <p class="meta">Chemical engineering, University of Nevada, Reno. Graduating May 2027.</p>
      </div>
    </div>
    <p>
      Working with production and defect data at Panasonic's battery plant in Sparks is what got me into data science.
      The next summer, in facilities engineering at Micron, I saw how closely AI connects to that kind of work, and it
      pulled me in. Now I want to build machine learning models that learn from plant data to predict how physical
      processes behave, and that's what I plan to study in a master's program starting Fall 2027.
    </p>
  </section>

  <h2>Interests</h2>
  <p>
    Mostly physics-informed and hybrid machine learning: models that learn from data but still obey mass and energy
    balances. I'm also interested in process monitoring with control charts and PCA, and in using production data to
    find out why defects happen.
  </p>

  <h2>Experience</h2>
  {internships.map((r) => (
    <Entry title={r.company} href={`/experience/${r.slug}/`} meta={`${r.role}, ${r.place}. ${r.dates}.`} text={r.blurb} />
  ))}
  <p class="more"><a href="/experience/">All experience, including research</a></p>

  <h2>Projects</h2>
  {projects.map((p) => (
    <Entry title={p.title} href={`/projects/${p.slug}/`} meta={`${p.context}. ${p.status}.`} text={p.blurb} />
  ))}

  <h2 id="contact">Contact</h2>
  <p>
    Email me at <a href="mailto:eli.santos.paul@gmail.com">eli.santos.paul@gmail.com</a>. I'm also on <a href="https://www.linkedin.com/in/elisantosengineering">LinkedIn</a> and <a href="https://github.com/epsantos333-sys">GitHub</a>.
  </p>
</Base>

<style>
  .hero { position: relative; isolation: isolate; padding: 16px 0 150px; }
  .hero h1 { margin-bottom: 0.2em; }
  .intro-head { display: flex; align-items: center; gap: 24px; margin-bottom: 1.4em; }
  .intro-head .meta { margin: 0; }
  .photo { width: 132px; height: 132px; border-radius: 50%; object-fit: cover; flex: none; }
  @media (max-width: 480px) { .intro-head { flex-direction: column; align-items: flex-start; gap: 16px; } .photo { width: 104px; height: 104px; } }
  /* Spans the full window width below the intro text. */
  .hero-chart {
    position: absolute;
    z-index: -1;
    left: calc(50% - 50vw);
    width: 100vw;
    bottom: 0;
    height: 190px;
    opacity: 0.14;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 30%);
    mask-image: linear-gradient(to bottom, transparent, #000 30%);
  }
  @media (max-width: 640px) { .hero { padding-bottom: 110px; } .hero-chart { height: 140px; opacity: 0.11; } }
  .more { font-family: var(--font-sans); font-size: 0.95rem; margin-top: 14px; }
</style>
