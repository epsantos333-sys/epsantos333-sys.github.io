---
import Base from '../../layouts/Base.astro';
import { internships, type Role } from '../../data/experience';

export function getStaticPaths() {
  return internships.map((role) => ({ params: { slug: role.slug }, props: { role } }));
}

const { role: r } = Astro.props as { role: Role };
---
<Base title={r.company} description={`${r.role} at ${r.company}. ${r.blurb}`}>
  <p><a class="back" href="/experience/">All experience</a></p>
  <h1>{r.company}</h1>
  <p class="meta">{r.role}, {r.place}. {r.dates}.</p>
  <p>{r.summary}</p>

  {r.work.map((w) => (
    <>
      <h2>{w.title}</h2>
      <p>{w.text}</p>
    </>
  ))}

  {r.tools && <p class="tools"><strong>Tools and methods:</strong> {r.tools}</p>}
</Base>

<style>
  .meta { margin-bottom: 1.6em; }
  h2 { font-size: 1.15rem; margin-top: 2rem; }
  .tools { margin-top: 2.4rem; padding-top: 1rem; border-top: 1px solid var(--border); font-size: 0.95rem; color: var(--muted); }
  .tools strong { color: var(--text); font-family: var(--font-sans); font-weight: 600; }
</style>
