---
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import { roles } from '../../data/experience';
---
<Base title="Experience" description="Internships at Micron Technology and Panasonic Energy, and undergraduate research at UNR.">
  <h1>Experience</h1>
  <p>Two summers in manufacturing, one in a battery plant and one at a semiconductor site, plus a year and a half in a chemistry research lab.</p>
  {roles.map((r) => (
    <Entry title={r.company} href={r.slug && `/experience/${r.slug}/`} meta={`${r.role}, ${r.place}. ${r.dates}.`} text={r.blurb} />
  ))}
</Base>
