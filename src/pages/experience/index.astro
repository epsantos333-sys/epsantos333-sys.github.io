---
import Base from '../../layouts/Base.astro';
import ExperienceCard from '../../components/ExperienceCard.astro';
import { roles } from '../../data/experience';
---
<Base title="Experience" description="Internships at Micron Technology and Panasonic Energy, and undergraduate research at UNR.">
  <p class="label">Experience</p>
  <h1>Industry and research</h1>
  <p class="lede muted">
    Two summers in manufacturing: semiconductor fab chemical systems at Micron and battery cell production at
    Panasonic. Both showed me how much production and sensor data a plant collects, and pushed me toward machine
    learning that models physical systems.
  </p>
  <div class="list">
    {roles.map((r) => <ExperienceCard role={r} />)}
  </div>
</Base>

<style>
  .lede { font-size: 1.1rem; max-width: 40em; }
  .list { display: grid; gap: 16px; margin-top: 24px; }
</style>
