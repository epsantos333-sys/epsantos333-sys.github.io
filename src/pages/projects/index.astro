---
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import { projects } from '../../data/projects';
---
<Base title="Projects" description="Process modeling and monitoring projects by Eli Santos.">
  <h1>Projects</h1>
  <p>Both are still in progress. I add results as each step is finished.</p>
  {projects.map((p) => (
    <Entry title={p.title} href={`/projects/${p.slug}/`} meta={`${p.context}. ${p.status}.`} text={p.blurb} />
  ))}
</Base>
