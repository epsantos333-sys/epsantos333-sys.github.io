---
import Base from '../../layouts/Base.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project: p } = Astro.props as { project: Project };
---
<Base title={p.title} description={p.blurb}>
  <p><a class="back" href="/projects/">All projects</a></p>
  <h1>{p.title}</h1>
  <p class="meta">{p.context}. {p.status}.</p>

  {p.intro.map((para) => <p>{para}</p>)}

  {p.figure && (
    <figure>
      <img src={p.figure.src} alt={p.figure.alt} width="1350" height="750" loading="lazy" />
      <figcaption>{p.figure.caption}</figcaption>
    </figure>
  )}

  <h2>What I've done so far</h2>
  <ul>{p.did.map((d) => <li>{d}</li>)}</ul>

  <h2>Where it stands</h2>
  <p>{p.now}</p>
  {p.repo && <p>Code: <a href={p.repo}>{p.repo.replace('https://', '')}</a></p>}
</Base>

<style>
  .meta { margin-bottom: 1.6em; }
  figure { margin: 2rem 0; }
  figure img { display: block; width: 100%; height: auto; border: 1px solid var(--border); }
  figcaption { font-family: var(--font-sans); font-size: 0.88rem; color: var(--muted); margin-top: 8px; line-height: 1.5; }
</style>
