---
import Base from '../layouts/Base.astro';
import { existsSync } from 'node:fs';

// Show the download link only once a resume PDF is in public/.
const hasResume = existsSync('public/Eli_Santos_Resume.pdf');

const skills = [
  ['Programming and data', 'Python (pandas, NumPy, SciPy, Matplotlib, scikit-learn, PyTorch), SQL, R, JMP, Excel'],
  ['Modeling and methods', 'Kinetic and thermodynamic modeling, nonlinear regression, root-finding and ODE solving, SPC, root cause and failure analysis, FMEA and FTA'],
  ['Engineering tools', 'ChemCAD, AutoCAD, P&ID interpretation, MES, Microsoft Copilot Studio'],
];
---
<Base title="About" description="Education, leadership and skills of Eli Santos, chemical engineering student at UNR.">
  <p class="label">About</p>
  <h1>Background</h1>
  <p class="lede">
    Chemical engineering senior at the University of Nevada, Reno (B.S. expected May 2027). I’m interested in
    physics-informed and hybrid machine learning for manufacturing and chemical process systems.
  </p>
  {hasResume && <p><a class="mono" href="/Eli_Santos_Resume.pdf">↓ Download resume (PDF)</a></p>}

  <p>Internships and research are on the <a href="/experience/">Experience</a> page.</p>

  <h2>Education</h2>
  <div class="card">
    <h3>University of Nevada, Reno</h3>
    <p class="muted">B.S. Chemical Engineering, expected May 2027</p>
    <p>
      Coursework: Transport Phenomena I and II, Thermodynamics, Reactor Design, Separation Processes, Process Design
      and Economics, Computers in Chemical Engineering, Probability and Statistics, Materials Characterization,
      Particle Technology.
    </p>
  </div>

  <h2>Leadership</h2>
  <ul>
    <li><strong>President, AIChE UNR Student Chapter</strong> (Aug 2026 – present; Vice President 2025–26, Secretary 2024–25). Lead the officer team and organize industry site tours with regional manufacturers.</li>
    <li><strong>PASS Leader and Peer Tutor</strong>, UNR Tutoring Center (2025). Led weekly exam reviews for 30+ students.</li>
  </ul>

  <h2>Skills</h2>
  <dl class="skills">
    {skills.map(([k, v]) => (<><dt class="label">{k}</dt><dd>{v}</dd></>))}
  </dl>
</Base>

<style>
  .lede { font-size: 1.15rem; max-width: 40em; }
  ul { padding-left: 1.2em; }
  li { margin-bottom: 0.45em; }
  .skills dt { margin-top: 12px; }
  .skills dd { margin: 2px 0 0; }
</style>
